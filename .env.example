# Copy to .env and fill in.
#
# These values target the HOST (running tests / `make demo` from your shell).
# Inside docker compose, app/worker containers receive overridden hostnames
# (`postgres`, `redis`, `minio`) via docker-compose.yml's `environment:` block.
# You do not need to maintain two .env files.

# --- App ---
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_JWT_SECRET=change-me-in-prod
APP_JWT_ALG=HS256

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aidocs

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Blob storage (MinIO in dev, S3 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aidocs-uploads

# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4.1
LLM_TEMPERATURE=0.0

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
